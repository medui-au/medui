# Created by ./install.sh (or: python3 scripts/init_env.py). Never commit or share this file.
COMPOSE_PROJECT_NAME=medui_os
POSTGRES_DB=medui
POSTGRES_USER=medui
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=
SECRET_KEY=
MEDUI_ENCRYPTION_KEY=
APP_NAME=MedUI
PRACTICE_TIMEZONE=Australia/Brisbane
SESSION_COOKIE_SECURE=false
# BP remains unconfigured until you supply this practice's read-only credentials.
BPSDB_HOST=
BPSDB_DATABASE=BPSPatients
BPSDB_USER=
BPSDB_PASSWORD=
BPSDB_DRIVER=ODBC Driver 18 for SQL Server
BPSDB_TRUST_SERVER_CERTIFICATE=false
# Host venv address; Compose overrides this for the app container.
OCR_SERVICE_URL=http://127.0.0.1:5707
OCR_CONTAINER_URL=http://liteparse:5707
OCR_API_KEY=
OCR_TIMEOUT=150
# Optional CA bundle path for an existing HTTPS OCR server.
OCR_CA_BUNDLE=
AI_ENABLED=false
MESSAGING_ENABLED=false
PIT_EXPORT_ENABLED=false
PATIENT_API_ENABLED=false
PATIENT_API_KEY=
PBS_API_KEY=

# Bind web app to all interfaces only when desired for this installation.
APP_BIND_HOST=127.0.0.1
APP_PORT=5005
